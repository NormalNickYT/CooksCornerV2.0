# ---------------------------------------------------------------------------
# Copy to .env and fill in. `npm run setup` expects this file to exist.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Port 5433 avoids clashing with a local Postgres.
DATABASE_URL="postgresql://cookscorner:cookscorner@localhost:5433/cookscorner?schema=public"
# Supabase only: the non-pooled connection used for migrations. Locally it is
# the same URL.
DIRECT_URL="postgresql://cookscorner:cookscorner@localhost:5433/cookscorner?schema=public"

# --- Sessions ---------------------------------------------------------------
# Any long random string. Generate one: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Leave empty to keep sessions in memory during development.
REDIS_URL="redis://localhost:6380"

# --- URLs -------------------------------------------------------------------
PORT=5000
API_URL="http://localhost:5000"
CLIENT_URL="http://localhost:5173"

# --- Google OAuth -----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client ID
# Authorised redirect URI must be exactly GOOGLE_CALLBACK_URL below.
# Leave GOOGLE_CLIENT_ID empty to disable Google login (email/password still works).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=8

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String  @id @unique @default(cuid())
  username String
  email    String  @unique
  avatar   String
  name     String
  googleId String? @unique
  password String?
  posts    Post[]
}

model Post {
  id              String         @id @unique @default(cuid())
  title           String
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  categories      PostCategory[]
  url             String?
  image           String
  createdAt       DateTime       @default(now())
  description     String?
  ingredients     Ingredient[]   @relation("PostIngredients")
  tips            String?
  status          String
  preparationTime Int
  cookTime        Int?
  totalTime       Int
  servings        Int
  approachSteps   Step[]         @relation("PostSteps")

  @@index([userId])
}

model Ingredient {
  id     String  @id @default(cuid())
  name   String
  amount Int
  unit   String
  post   Post?   @relation("PostIngredients", fields: [postId], references: [id])
  postId String?

  @@index([postId])
}

model Step {
  id      String  @id @default(cuid())
  content String
  order   Int
  post    Post?   @relation("PostSteps", fields: [postId], references: [id])
  postId  String?

  @@index([postId])
}

model Category {
  id           String         @id @unique @default(cuid())
  title        String         @unique
  PostCategory PostCategory[]
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([postId])
  @@index([categoryId])
}
